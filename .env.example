# Configuracion del Backend (copiar como .env local, NUNCA subir .env a GitHub)
PORT=3001
APP_TIMEZONE=America/Argentina/Buenos_Aires

# En produccion (Render + Neon) usar cadena PostgreSQL real:
# DATABASE_URL=postgresql://usuario:clave@host.neon.tech:5432/focusflow
DATABASE_URL=file:./data/focusflow.sqlite

# Origen permitido por CORS (en produccion: URL de Netlify)
FRONTEND_URL=http://localhost:5173

# Clave de prueba para ruta administrativa protegida (401/403)
ADMIN_TOKEN=cambiar_en_produccion

# Configuracion del Frontend (en Netlify)
VITE_API_URL=http://localhost:3001
